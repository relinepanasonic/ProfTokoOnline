# Supabase — from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server only, never expose to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Prof One integration (existing)
NEXT_PUBLIC_PROONE_API_URL=
NEXT_PUBLIC_PROONE_API_KEY=

# Accounting ERP integration (accounting.profesoronline.id) — GET /api/erp/upload-log.
# Generate with: openssl rand -hex 32
# The ERP calls this with header: Authorization: Bearer <ERP_API_KEY>
# Unset (or wrong key) -> every request gets 401, no details in the body.
ERP_API_KEY=
# Which tenant's uploads the ERP endpoint reads. Defaults to Prof Toko
# Online's own client_id in code if left unset — only set this if the ERP
# should read a different tenant's upload log instead.
ERP_CLIENT_ID=
